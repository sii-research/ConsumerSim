# OpenAI-compatible LLM endpoint (used by consumersim/engine.py and experiments/)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Public macroeconomic & news data APIs (for running full data fetchers from scratch)
FRED_API_KEY=your-fred-api-key
NYT_API_KEY=your-nyt-archive-api-key
GUARDIAN_API_KEY=your-guardian-open-platform-key

# Local directory storing downloaded Michigan microdata / FRED / NYT / Guardian files
CONSUMERSIM_DATA_DIR=./data

# Optional: MCP proxy / live dashboard backend configuration
CONSUMERSIM_API_BASE_URL=https://your-consumersim-backend.example.com
CONSUMERSIM_API_KEY=replace-with-your-backend-token
